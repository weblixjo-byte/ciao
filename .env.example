# MongoDB Connection URI (Direct ReplicaSet or SRV format)
MONGODB_URI=mongodb://username:password@shard-00-00.mongodb.net:27017,shard-00-01.mongodb.net:27017/ciao_loyalty?ssl=true&replicaSet=atlas-shard-0&authSource=admin&retryWrites=true&w=majority

# JWT Secret for Session Signing
JWT_SECRET=your_super_secure_jwt_secret_token

# White-Label Default Store Configuration
NEXT_PUBLIC_DEFAULT_STORE_NAME=ciao ciao
NEXT_PUBLIC_DEFAULT_TAGLINE=Italian Restaurant - Pizza & Pasta
NEXT_PUBLIC_DEFAULT_CURRENCY=JOD
NEXT_PUBLIC_DEFAULT_POINTS_PER_UNIT=10
NEXT_PUBLIC_DEFAULT_DISCOUNT_PER_100_PTS=1.00
NEXT_PUBLIC_DEFAULT_WELCOME_BONUS_PTS=50
NEXT_PUBLIC_DEFAULT_BRAND_COLOR=#36543D
NEXT_PUBLIC_DEFAULT_ACCENT_COLOR=#D4E2D4

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@CIAOCIAOJO.com
